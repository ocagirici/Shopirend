# Copy this file to local.properties if Android Studio does not create it.
sdk.dir=C\:\\Users\\YOUR_NAME\\AppData\\Local\\Android\\Sdk

# Android Emulator -> backend running on this computer
SHOPIREND_API_BASE_URL=http://10.0.2.2:8080/api/

# Physical Android device -> replace with your computer's LAN address
# SHOPIREND_API_BASE_URL=http://192.168.1.100:8080/api/

